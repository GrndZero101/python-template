{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv tool:*)",
      "Bash(uv lock:*)",
      "Bash(ruff:*)",
      "Bash(ty:*)",
      "Bash(rumdl:*)",
      "Bash(prek:*)",
      "Bash(copier:*)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git",
            "args": [
              "-C",
              "${CLAUDE_PROJECT_DIR}",
              "status",
              "--short",
              "--branch"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "template/tools/branch_guard.py",
              "--protected",
              "main",
              "master"
            ],
            "timeout": 15,
            "statusMessage": "Checking branch..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-config",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "template/tools/gate.py",
              "--skip",
              "no-commit-to-branch,generation-tests"
            ],
            "timeout": 120,
            "statusMessage": "Formatting and checking..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  }
}
