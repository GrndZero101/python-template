"""The `browse` app, driven headless through Textual's Pilot, and its command through `main`.

Each async test is marked `@pytest.mark.asyncio`: pytest-asyncio runs it on an event loop. Assert on
widget state through `query_one`, never on rendered characters, and `await pilot.pause()` after an
interaction so pending messages settle first.

The command's tests replace `browse.run_screen`, so they check what reaches the screen, or that
nothing does, without starting one.
"""

from pathlib import Path

import pytest
from textual.widgets import DataTable, Input

from {{ package_name }} import browse
from {{ package_name }}.browse import BrowseApp
from {{ package_name }}.cli import main
from {{ package_name }}.rows import RowTable

SOURCE = RowTable(
    headers=("name", "region"),
    rows=(("web-1", "eu-west-1"), ("web-2", "us-east-1"), ("db-1", "eu-west-1")),
)
SIZE = (80, 24)  # pinned, so layout is the same on every machine


@pytest.mark.asyncio
async def test_every_row_shows_at_first() -> None:
    app = BrowseApp(SOURCE)
    async with app.run_test(size=SIZE):
        table = app.query_one(DataTable)
        assert (table.row_count, len(table.columns)) == (3, 2)


@pytest.mark.asyncio
async def test_typing_narrows_the_table() -> None:
    app = BrowseApp(SOURCE)
    async with app.run_test(size=SIZE) as pilot:
        await pilot.press("e", "u")
        await pilot.pause()
        assert app.query_one(DataTable).row_count == 2


@pytest.mark.asyncio
async def test_escape_clears_the_filter() -> None:
    app = BrowseApp(SOURCE)
    async with app.run_test(size=SIZE) as pilot:
        await pilot.press("d", "b")
        await pilot.pause()
        assert app.query_one(DataTable).row_count == 1
        await pilot.press("escape")
        await pilot.pause()
        assert app.query_one(Input).value == ""
        assert app.query_one(DataTable).row_count == 3


def test_the_command_opens_the_screen_on_the_file_rows(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    opened: list[RowTable] = []
    monkeypatch.setattr(browse, "run_screen", opened.append)
    path = tmp_path / "hosts.csv"
    path.write_text("name,region\nweb-1,eu-west-1\n", encoding="utf-8")
    assert main(["browse", str(path)]) == 0
    assert opened == [RowTable(headers=("name", "region"), rows=(("web-1", "eu-west-1"),))]


def test_a_bad_file_exits_1_before_the_app_starts(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    opened: list[RowTable] = []
    monkeypatch.setattr(browse, "run_screen", opened.append)
    path = tmp_path / "hosts.csv"
    path.write_text("name,region\nweb-1\n", encoding="utf-8")
    assert main(["browse", str(path)]) == 1
    captured = capsys.readouterr()
    assert "line 2" in captured.err
    assert not captured.out
    assert not opened


def test_another_format_is_a_usage_error(tmp_path: Path) -> None:
    path = tmp_path / "hosts.json"
    path.write_text("{}", encoding="utf-8")
    assert main(["browse", str(path)]) == 2
