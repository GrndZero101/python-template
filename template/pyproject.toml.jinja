# A fallback, written only when the project has no pyproject.toml of its own (`_skip_if_exists` in
# copier.yml). A use case ships a fuller one, and copier never overwrites it, so this file reaches
# a project only when the base is applied on its own: a prototype, or a repo adopting the guards.
#
# The tool settings below repeat in every use case's pyproject.toml, because pytest, ty and rumdl
# take the first config file they find and merge nothing. A generation test keeps the two in step.
[project]
name = "{{ project_name | lower | replace(' ', '-') | replace('_', '-') }}"
version = "0.1.0"
requires-python = ">={{ python_version }}"
license = "{% if license == 'Proprietary' %}LicenseRef-Proprietary{% else %}{{ license }}{% endif %}"
authors = [
    { name = "{{ author_name }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }
]
dependencies = []

[dependency-groups]
dev = [
    "debugpy>=1.8.21",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
]

# ruff's rules live in ruff-base.toml. Add only `extend-*` keys here: a `select` or
# `per-file-ignores` of your own would replace the base's lists instead of adding to them.
[tool.ruff]
extend = "ruff-base.toml"
target-version = "py{{ python_version | replace('.', '') }}"

[tool.rumdl]
line-length = 100
respect-gitignore = true
exclude = [".venv", "node_modules"]

[tool.rumdl.MD013]
code_blocks = false  # never wrap code
tables = false

[tool.ty.src]
exclude = [".claude"]  # see extend-exclude in ruff-base.toml

[tool.ty.environment]
# tools/ is not a package, so ty needs it named explicitly to resolve its tests.
extra-paths = ["tools"]

[tool.pytest.ini_options]
addopts = "-x -q --tb=short"
strict_config = true                # a typo in this section is an error, not a silent no-op
strict_markers = true               # an unregistered marker is an error, not a new marker
strict_xfail = true                 # an xfail that starts passing fails, so it gets removed
strict_parametrization_ids = true   # two parametrized cases with the same id are an error
# A deprecation in any dependency fails a test the day it appears. Silence a specific, understood
# warning with its own "ignore:..." line below this one; never remove this line.
filterwarnings = ["error"]
# tests/ is the product's suite. tools/tests/ tests the template's machinery, kept apart so tests/
# holds only what a new test should be modelled on.
testpaths = ["tests", "tools/tests"]
# tools/ so the hooks' tests import them; the root so a test imports a uv script as scripts.<name>.
pythonpath = ["tools", "."]
