[project]
name = "{{ package_name | replace('_', '-') }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
requires-python = ">={{ python_version }}"
dependencies = [
{%- if project_type == "cli-modern" %}
    "loguru>=0.7.3",
    "pydantic>=2.13.4",
    "pydantic-settings>=2.15.0",
    "rich>=15.0.0",
    "typer>=0.27.0",
{%- elif project_type == "fastapi" %}
    "fastapi>=0.121.0",
    "pydantic>=2.13.4",
    "uvicorn[standard]>=0.40.0",
{%- elif project_type == "tui" %}
    "textual>=7.2.0",
{%- elif project_type == "data" %}
    "duckdb>=1.4.2",
    "polars>=1.35.1",
    "pyarrow>=22.0.0",
{%- endif %}
]
{% if project_type == "cli-modern" %}
[project.scripts]
{{ script_name }} = "{{ package_name }}.cli:main"
{% endif %}
[build-system]
requires = ["uv_build>=0.12.21,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "debugpy>=1.8.21",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
]

# ---------------------------------------------------------------------------
# ruff — replaces black, isort, flake8, pylint, bandit, pyupgrade
# ---------------------------------------------------------------------------
[tool.ruff]
line-length = 100
# Skill reference files are templates for code that lives elsewhere: they import modules that
# exist only once copied, and tests there need tests/'s exemptions. The generation tests copy them
# where they belong and gate them there; the conventions hook and ty skip them likewise.
extend-exclude = [".claude"]
target-version = "py{{ python_version | replace('.', '') }}"
preview = true  # required: several rules below are preview rules, and `ignore` names rules

[tool.ruff.lint]
# Preview rules are opted into one by one, by code. Selected through a prefix, every preview rule a
# ruff release adds under it arrives with the upgrade — 124 of them on 0.16.10 — so a version bump
# alone could change what the gate blocks, or rewrite suppression comments mid-gate.
explicit-preview-rules = true
select = [
    "E", "W", "F", "I", "UP", "N",     # core, imports, modernization, naming
    "D", "ANN",                        # docstrings + annotations
    "B",                               # bugbear — B023 loop-var closure capture
    "C4", "SIM", "PERF", "FURB", "RUF",
    "RET",                             # RET505 no else-after-return -> guard clauses
    "TRY", "EM", "BLE",                # exception hygiene, intact tracebacks
    "LOG", "G", "T20",                 # logging correctness; T20 bans print
    "PTH", "DTZ", "ARG", "SLF", "FBT", "PT", "S",
    "PL", "C90",                       # the complexity dials below
    # Preview rules, each chosen. The first four back rows of CLAUDE.md's enforcement table:
    "PLR1702", "PLR0914",              # too-many-nested-blocks, too-many-locals
    "PLW1514",                         # unspecified-encoding
    "PLC2701",                         # import-private-name
    # The rest are bug detectors: mutating the list being looped over, `dict` iterated without
    # `.items()`, a set modified while iterating it, a mutable dataclass default shared between
    # instances, eager formatting in a logging call, and a context manager whose cleanup is skipped
    # when the body raises.
    "B909", "PLE1141", "PLE4703", "RUF045", "RUF065", "RUF075",
{%- if project_type == "fastapi" %}
    "FAST",                            # FastAPI-specific: redundant response_model, raw Depends
{%- endif %}
]
# ruff 0.16 wants rule names rather than codes here, which reads better anyway.
ignore = [
    # mutually conflicting docstring rules — pick one of each pair
    "incorrect-blank-line-before-class",
    "multi-line-summary-second-line",
    # docstrings required on public functions/classes, not on every module
    "undocumented-public-module",
    "undocumented-public-package",
    "undocumented-magic-method",
    "undocumented-public-init",
    # the formatter owns line length
    "line-too-long",
    # conflict with the formatter
    "missing-trailing-comma",
    "single-line-implicit-string-concatenation",
    # redundant with EM (which already forces messages out of the raise)
    "raise-vanilla-args",
]
# Reported, never auto-removed. The edit-time gate runs `--fix` after every save, so an import
# added one edit ahead of its first use would be deleted before that use lands.
unfixable = ["unused-import"]

# The maintainability dials. These are what indirectly penalise nested helpers:
# a nested def consumes a local slot and its body inflates the parent.
[tool.ruff.lint.mccabe]
max-complexity = 8

[tool.ruff.lint.pylint]
max-nested-blocks = 3
max-locals = 12
max-statements = 40
max-args = 5
max-branches = 10
max-returns = 6

[tool.ruff.lint.per-file-ignores]
# Tests assert, use bare literals, and poke at internals — all fine there.
"tests/**" = ["assert", "D", "ANN", "magic-value-comparison", "SLF"]
"tools/tests/**" = ["assert", "D", "ANN", "magic-value-comparison", "SLF"]
# The checker's whole job is printing findings, to stderr.
"tools/**" = ["T20"]
# Invoking an external tool IS this module's purpose, so the subprocess warnings cannot be
# designed away. The command is built from a literal list, never a shell string, and `prek`
# is resolved from PATH deliberately so the hook follows whatever uv installed.
"tools/gate.py" = [
    "subprocess-without-shell-equals-true",
    "start-process-with-partial-path",
]

# ---------------------------------------------------------------------------
# rumdl — markdown lint + format, mirrors ruff's check/fmt split
# ---------------------------------------------------------------------------
[tool.rumdl]
line-length = 100
respect-gitignore = true
exclude = [".venv", "node_modules"]

[tool.rumdl.MD013]
code_blocks = false  # never wrap code
tables = false

# ---------------------------------------------------------------------------
# ty — replaces mypy
# ---------------------------------------------------------------------------
[tool.ty.src]
exclude = [".claude"]  # see extend-exclude under [tool.ruff]

[tool.ty.environment]
# tools/ is not a package, so ty needs it named explicitly to resolve its tests.
extra-paths = ["tools"]

# ---------------------------------------------------------------------------
[tool.pytest.ini_options]
addopts = "-x -q --tb=short"
# Named one by one rather than `strict = true`, which also adopts every strictness option a later
# pytest adds: the same reason ruff's preview rules are listed by code above.
strict_config = true                # a typo in this section is an error, not a silent no-op
strict_markers = true               # an unregistered marker is an error, not a new marker
strict_xfail = true                 # an xfail that starts passing fails, so it gets removed
strict_parametrization_ids = true   # two parametrized cases with the same id are an error
# A deprecation in typer, pydantic or anything else fails a test the day it appears, rather than
# the code breaking at the dependency's next major version. Silence a specific, understood warning
# with its own "ignore:..." line below this one; never remove this line.
filterwarnings = ["error"]
# tests/ is the product's suite. tools/tests/ tests the template's machinery — the hooks and the
# conventions checker — kept apart so tests/ holds only what a new test should be modelled on.
testpaths = ["tests", "tools/tests"]
pythonpath = ["tools"]  # so the hooks and the conventions checker are importable by their tests
