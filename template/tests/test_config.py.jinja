"""Settings precedence: command-line flag, then environment variable, then default.

The config file's place between the environment and the default is in `tests/test_config_file.py`.

The last section checks the wiring. Adding a setting takes four coordinated edits — `Settings`,
`_Overrides`, `load_settings` and an option in `options.py` — and a missed one fails silently: the
flag is accepted and ignored, or the variable is read but never documented. These tests name
whichever edit is missing. A secret setting takes none of the three flag edits, and the tests
check that a credential's field is typed `SecretStr`, so it is masked wherever it is shown.
"""

import functools
import inspect
from typing import Any

import pytest
import typer

from {{ package_name }} import config
from {{ package_name }}.cli import app
from {{ package_name }}.config import (
    ENV_PREFIX,
    Settings,
    SettingsError,
    env_var,
    load_settings,
    secret_fields,
)
from {{ package_name }}.output import OutputFormat

OUTPUT_VAR = env_var("output")
VERBOSE_VAR = env_var("verbose")


def test_defaults_apply_when_nothing_is_set() -> None:
    assert load_settings() == Settings(verbose=False, output=OutputFormat.table)


def test_environment_overrides_the_default(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv(OUTPUT_VAR, "json")
    assert load_settings().output is OutputFormat.json


def test_flag_overrides_the_environment(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv(OUTPUT_VAR, "json")
    assert load_settings(output=OutputFormat.table).output is OutputFormat.table


def test_explicit_false_flag_overrides_a_true_environment(monkeypatch: pytest.MonkeyPatch) -> None:
    """`--no-verbose` must beat the variable: `False` is a value, only `None` means absent."""
    monkeypatch.setenv(VERBOSE_VAR, "1")
    assert load_settings(verbose=False).verbose is False


def test_absent_flag_does_not_mask_the_environment(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv(VERBOSE_VAR, "1")
    assert load_settings(verbose=None).verbose is True


@pytest.mark.parametrize("raw", ["1", "true", "yes", "on", "TRUE"])
def test_boolean_variables_accept_common_spellings(
    monkeypatch: pytest.MonkeyPatch, raw: str
) -> None:
    monkeypatch.setenv(VERBOSE_VAR, raw)
    assert load_settings().verbose is True


def test_invalid_variable_names_the_value_the_flag_and_the_variable(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv(OUTPUT_VAR, "xml")
    with pytest.raises(SettingsError, match=OUTPUT_VAR) as raised:
        load_settings()
    message = str(raised.value)
    assert "'xml'" in message
    assert "--output" in message


def test_unrelated_prefixed_variable_is_ignored(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv(f"{ENV_PREFIX}NOT_A_SETTING", "x")
    assert load_settings() == Settings()


def test_env_var_is_the_prefix_plus_the_upper_case_field() -> None:
    assert env_var("output") == f"{ENV_PREFIX}OUTPUT"


# --- wiring: every setting reaches every place it must ------------------------------------


def _capture(seen: dict[str, object], **kwargs: object) -> object:
    """Stand in for `Settings`, recording the keywords `load_settings` passed it."""
    seen.update(kwargs)
    return object()


def _option_help(command: typer.main.TyperGroup) -> str:
    """Return the help text of every option on the app and on each of its commands."""
    params = list(command.params)
    for subcommand in command.commands.values():
        params.extend(subcommand.params)
    texts = [getattr(param, "help", None) or "" for param in params]
    return "\n".join(texts)


SECRET_FIELDS = secret_fields()
# A secret has no flag, so it is not in `_Overrides` or `load_settings`: a flag's value is visible
# in shell history and to anyone who can list processes.
FLAG_FIELDS = sorted(field for field in Settings.model_fields if field not in SECRET_FIELDS)
# A field whose name ends in one of these holds a credential. Extend it for your own naming.
CREDENTIAL_SUFFIXES = ("token", "password", "secret", "api_key", "private_key")


def test_every_credential_setting_is_secret() -> None:
    """A token typed `str` leaks into `about` and the `-v` debug log; `SecretStr` masks it.

    It runs before the flag steps below, which a credential skips, so their failures do not lead
    a model to give a token a flag.
    """
    exposed = [
        field
        for field in Settings.model_fields
        if field.endswith(CREDENTIAL_SUFFIXES) and field not in SECRET_FIELDS
    ]
    assert exposed == [], (
        f"type {exposed} as SecretStr and drop their flags: "
        'follow "Recipe: add a secret setting" in the python-cli-modern skill'
    )


def test_overrides_declare_every_setting() -> None:
    """Step 1 of the add-a-setting recipe: a field in `Settings` must also be in `_Overrides`."""
    assert sorted(config._Overrides.__annotations__) == FLAG_FIELDS


def test_load_settings_takes_a_keyword_for_every_setting() -> None:
    """Step 2: without the keyword there is no way for a flag to reach the setting."""
    keywords = sorted(inspect.signature(load_settings).parameters)
    assert keywords == FLAG_FIELDS


def test_load_settings_passes_every_given_flag_through(monkeypatch: pytest.MonkeyPatch) -> None:
    """Step 2 again: a keyword accepted but never copied into the overrides is silently ignored."""
    seen: dict[str, object] = {}
    monkeypatch.setattr(config, "Settings", functools.partial(_capture, seen))
    given: dict[str, Any] = {field: f"value of {field}" for field in FLAG_FIELDS}
    load_settings(**given)
    assert seen == given


@pytest.mark.parametrize("field", FLAG_FIELDS)
def test_every_setting_has_a_flag_naming_its_variable(field: str) -> None:
    """Step 3: a flag on some command must name the variable, or nobody can discover it."""
    command = typer.main.get_command(app)
    assert isinstance(command, typer.main.TyperGroup)
    assert f"(env: {env_var(field)})" in _option_help(command)
