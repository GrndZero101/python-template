"""The YAML config file: where it lives, where it sits in the precedence, and how it fails.

`conftest.py` points `XDG_CONFIG_HOME` into `tmp_path`, so `default_config_path(PROG_NAME)` is a
fresh, empty location in every test, and the developer's own file is never read.
"""

import json
from pathlib import Path

import pytest

from {{ package_name }}.cli import main
from {{ package_name }}.config import PROG_NAME, SettingsError, env_var, load_settings
from {{ package_name }}.config_file import CONFIG_FILE_NAME, default_config_path
from {{ package_name }}.output import OutputFormat

OUTPUT_VAR = env_var("output")
CONFIG_VAR = env_var("config")
HOME = Path("/home/someone")


def _home() -> Path:
    return HOME


def _write(path: Path, text: str) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    return path


@pytest.fixture
def default_file() -> Path:
    """The path the tool reads when nothing names a file: inside this test's config home."""
    return default_config_path(PROG_NAME)


def _error_from(config: Path | None = None) -> str:
    """Return the message `load_settings` raises, given this `--config`."""
    with pytest.raises(SettingsError) as raised:
        load_settings(config=config)
    return str(raised.value)


# --- where it lives -----------------------------------------------------------------------


@pytest.mark.parametrize("platform", ["linux", "darwin", "win32"])
def test_xdg_config_home_wins_on_every_platform(tmp_path: Path, platform: str) -> None:
    environ = {"XDG_CONFIG_HOME": str(tmp_path), "APPDATA": str(tmp_path / "appdata")}
    path = default_config_path("tool", environ=environ, platform=platform, home=_home)
    assert path == tmp_path / "tool" / CONFIG_FILE_NAME


def test_a_relative_xdg_config_home_is_ignored() -> None:
    """The XDG spec says a relative path is invalid and must be ignored."""
    environ = {"XDG_CONFIG_HOME": "relative/dir"}
    path = default_config_path("tool", environ=environ, platform="linux", home=_home)
    assert path == HOME / ".config" / "tool" / CONFIG_FILE_NAME


@pytest.mark.parametrize("platform", ["linux", "darwin"])
def test_unix_alikes_default_to_dot_config(platform: str) -> None:
    path = default_config_path("tool", environ={}, platform=platform, home=_home)
    assert path == HOME / ".config" / "tool" / CONFIG_FILE_NAME


def test_windows_defaults_to_the_roaming_appdata(tmp_path: Path) -> None:
    environ = {"APPDATA": str(tmp_path)}
    path = default_config_path("tool", environ=environ, platform="win32", home=_home)
    assert path == tmp_path / "tool" / CONFIG_FILE_NAME


def test_windows_without_appdata_falls_back_under_home() -> None:
    path = default_config_path("tool", environ={}, platform="win32", home=_home)
    assert path == HOME / "AppData" / "Roaming" / "tool" / CONFIG_FILE_NAME


# --- where it sits: flag, then environment, then file, then default ----------------------


def test_a_missing_default_file_changes_nothing(default_file: Path) -> None:
    settings = load_settings()
    assert (settings.output, settings.config) == (OutputFormat.table, default_file)


def test_the_file_overrides_the_default(default_file: Path) -> None:
    _write(default_file, "output: json\n")
    assert load_settings().output is OutputFormat.json


def test_the_environment_beats_the_file(
    default_file: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    _write(default_file, "output: json\n")
    monkeypatch.setenv(OUTPUT_VAR, "table")
    assert load_settings().output is OutputFormat.table


def test_a_flag_beats_the_file(default_file: Path) -> None:
    _write(default_file, "output: json\n")
    assert load_settings(output=OutputFormat.table).output is OutputFormat.table


def test_an_empty_file_changes_nothing(default_file: Path) -> None:
    _write(default_file, "")
    assert load_settings().output is OutputFormat.table


# --- which file: --config, then the variable, then the default ---------------------------


def test_the_config_flag_names_the_file(tmp_path: Path) -> None:
    named = _write(tmp_path / "other.yaml", "output: json\n")
    assert load_settings(config=named).output is OutputFormat.json


def test_the_config_variable_names_the_file(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    named = _write(tmp_path / "other.yaml", "output: json\n")
    monkeypatch.setenv(CONFIG_VAR, str(named))
    assert load_settings().config == named
    assert load_settings().output is OutputFormat.json


def test_the_config_flag_beats_the_variable(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setenv(CONFIG_VAR, str(_write(tmp_path / "env.yaml", "output: json\n")))
    flagged = _write(tmp_path / "flag.yaml", "verbose: true\n")
    settings = load_settings(config=flagged)
    assert (settings.config, settings.output, settings.verbose) == (
        flagged,
        OutputFormat.table,
        True,
    )


# --- how it fails: every message names the file ------------------------------------------


def test_a_named_file_must_exist(tmp_path: Path) -> None:
    missing = tmp_path / "missing.yaml"
    assert str(missing) in _error_from(config=missing)


def test_invalid_yaml_names_the_file(default_file: Path) -> None:
    _write(default_file, "output: [unclosed\n")
    message = _error_from()
    assert "not valid YAML" in message
    assert str(default_file) in message


def test_a_file_that_is_not_a_mapping_names_the_file(default_file: Path) -> None:
    _write(default_file, "- output\n- json\n")
    message = _error_from()
    assert "must map setting names to values" in message
    assert str(default_file) in message


def test_an_unknown_key_names_the_key_and_the_file(default_file: Path) -> None:
    _write(default_file, "outptu: json\n")
    message = _error_from()
    assert "outptu is not a setting" in message
    assert str(default_file) in message


def test_the_file_cannot_name_another_config_file(default_file: Path) -> None:
    _write(default_file, "config: elsewhere.yaml\n")
    assert "config is not a setting" in _error_from()


def test_an_invalid_value_offers_the_config_file_as_a_source(default_file: Path) -> None:
    _write(default_file, "output: xml\n")
    message = _error_from()
    assert "'xml'" in message
    assert "the config file" in message


def test_an_unquoted_no_is_a_boolean_not_a_string(default_file: Path) -> None:
    """PyYAML reads YAML 1.1, where `no` is `false`: validation rejects it rather than guessing."""
    _write(default_file, "output: no\n")
    assert "output=False" in _error_from()


# --- through main -------------------------------------------------------------------------


def test_config_flag_reaches_the_command(
    tmp_path: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    named = _write(tmp_path / "other.yaml", "verbose: true\noutput: json\n")
    assert main(["--config", str(named), "about"]) == 0
    captured = capsys.readouterr()
    assert json.loads(captured.out)["settings"]["config"] == str(named)
    assert "resolved" in captured.err


def test_a_bad_config_file_is_a_usage_error_naming_it(
    tmp_path: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    missing = tmp_path / "missing.yaml"
    assert main(["--config", str(missing), "about"]) == 2
    captured = capsys.readouterr()
    assert str(missing) in captured.err
    assert not captured.out
