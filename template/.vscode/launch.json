{
  // The style rules only pay off if stepping through is one keypress.
  // justMyCode is false everywhere so you can step into library frames.
  "version": "0.2.0",
  "configurations": [
    {
      // Through the launcher, not "program": "${file}". Modules under src/ use relative imports,
      // which fail when the file runs as a top-level script. The launcher runs a file under src/
      // as `python -m` would and any other file by path. See tools/debug_module.py.
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/debug_module.py",
      "args": ["${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv", "--no-header", "-p", "no:cacheprovider"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-vv", "--no-header"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Attach to process (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false
    }
  ]
}
