"""Tests for the reference httpx client: retries, Retry-After, timeouts and the User-Agent.

Every response comes from an `httpx.MockTransport`, and `sleep` is a recorder, so nothing touches
the network and nothing waits.
"""

import functools
from datetime import UTC, datetime

import httpx

from {{ package_name }}.config import PROG_NAME
from {{ package_name }}.http_client import (
    MAX_ATTEMPTS,
    build_client,
    parse_retry_after,
)

NOW = datetime(2026, 10, 2, 12, 0, tzinfo=UTC)


def _replay(
    responses: list[httpx.Response], seen: list[httpx.Request], request: httpx.Request
) -> httpx.Response:
    """MockTransport handler: record the request, answer with the next response in `responses`."""
    seen.append(request)
    return responses.pop(0)


def _client(
    responses: list[httpx.Response], seen: list[httpx.Request], waits: list[float]
) -> httpx.Client:
    handler = functools.partial(_replay, responses, seen)
    return build_client(transport=httpx.MockTransport(handler), sleep=waits.append)


def test_a_503_is_retried_with_backoff_until_it_succeeds() -> None:
    seen: list[httpx.Request] = []
    waits: list[float] = []
    responses = [httpx.Response(503), httpx.Response(503), httpx.Response(200, text="ok")]
    with _client(responses, seen, waits) as client:
        response = client.get("https://api.example.test/items")
    assert response.status_code == 200
    assert len(seen) == 3
    assert waits == [0.5, 1.0]


def test_retry_after_in_seconds_is_obeyed() -> None:
    waits: list[float] = []
    responses = [httpx.Response(429, headers={"Retry-After": "7"}), httpx.Response(200)]
    with _client(responses, [], waits) as client:
        client.get("https://api.example.test/items")
    assert waits == [7.0]


def test_retry_after_as_an_http_date_is_converted_to_seconds() -> None:
    assert parse_retry_after("Fri, 02 Oct 2026 12:00:30 GMT", NOW) == 30.0


def test_an_unreadable_retry_after_falls_back_to_backoff() -> None:
    assert parse_retry_after("soon", NOW) is None


def test_it_gives_up_after_the_last_attempt_and_returns_that_response() -> None:
    seen: list[httpx.Request] = []
    responses = [httpx.Response(502) for _ in range(MAX_ATTEMPTS)]
    with _client(responses, seen, []) as client:
        response = client.get("https://api.example.test/items")
    assert response.status_code == 502
    assert len(seen) == MAX_ATTEMPTS


def test_a_client_error_is_not_retried() -> None:
    seen: list[httpx.Request] = []
    with _client([httpx.Response(404)], seen, []) as client:
        assert client.get("https://api.example.test/missing").status_code == 404
    assert len(seen) == 1


def test_a_post_is_never_retried() -> None:
    """The server may already have acted on it; repeating it is not safe."""
    seen: list[httpx.Request] = []
    with _client([httpx.Response(503)], seen, []) as client:
        assert client.post("https://api.example.test/items", json={}).status_code == 503
    assert len(seen) == 1


def test_requests_name_the_tool_in_their_user_agent() -> None:
    seen: list[httpx.Request] = []
    with _client([httpx.Response(200)], seen, []) as client:
        client.get("https://api.example.test/")
    assert seen[0].headers["User-Agent"].startswith(f"{PROG_NAME}/")


def test_timeouts_are_set_per_phase() -> None:
    with _client([], [], []) as client:
        assert client.timeout.connect == 3.0
        assert client.timeout.read == 10.0
