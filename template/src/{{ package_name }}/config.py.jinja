"""The tool's identity and its resolved configuration.

Every setting resolves in one order: command-line flag, then environment variable, then the field
default. pydantic-settings does the merge. A value passed to the `Settings` constructor beats the
environment, which beats the default, so a flag only has to arrive as a constructor argument to
win. Every typer option therefore defaults to `None`, meaning "not given", and `load_settings`
drops those before constructing — a `None` that reached the model would mask the environment.

Each field reads `{{ script_name | upper | replace('-', '_') }}_<FIELD>`, so `output` is
`{{ script_name | upper | replace('-', '_') }}_OUTPUT`. To add a setting:

1. Add the field to `Settings`, with a default, and to `_Overrides`.
2. Add a keyword to `load_settings` and pass it through.
3. Declare the flag in `options.py` with a `None` default, naming `env_var("<field>")` in its help.

The wiring tests at the end of `tests/test_config.py` fail, naming the step, until all three
are done.

No `.env` file is read, so a stray file in the working directory cannot change a test's outcome.
Add `env_file=".env"` to `model_config` to opt in.
"""

from typing import TypedDict

from pydantic import ValidationError
from pydantic_core import ErrorDetails
from pydantic_settings import BaseSettings, SettingsConfigDict

from .output import OutputFormat

PROG_NAME = "{{ script_name }}"
DIST_NAME = "{{ package_name | replace('_', '-') }}"
ENV_PREFIX = "{{ script_name | upper | replace('-', '_') }}_"


class SettingsError(ValueError):
    """A setting failed validation. The message names both the flag and the variable."""


class _Overrides(TypedDict, total=False):
    """The flags actually given. A key is present only when its flag was."""

    verbose: bool
    output: OutputFormat


class Settings(BaseSettings):
    """Every setting this tool reads, validated once at the boundary."""

    model_config = SettingsConfigDict(env_prefix=ENV_PREFIX, frozen=True, extra="forbid")

    verbose: bool = False
    output: OutputFormat = OutputFormat.table


def env_var(field: str) -> str:
    """Return the environment variable that sets `field`, e.g. `output` -> `<PREFIX>OUTPUT`."""
    return f"{ENV_PREFIX}{field.upper()}"


def _describe(error: ErrorDetails) -> str:
    """Render one validation error as `field=value (--flag or VAR): reason`."""
    field = str(error["loc"][0]) if error["loc"] else "settings"
    flag = f"--{field.replace('_', '-')}"
    return f"{field}={error['input']!r} ({flag} or {env_var(field)}): {error['msg']}"


def load_settings(
    *,
    verbose: bool | None = None,
    output: OutputFormat | None = None,
) -> Settings:
    """Resolve settings from the given flags, then the environment, then the defaults.

    A keyword left as `None` was not given on the command line and does not override anything.
    """
    given: _Overrides = {}
    if verbose is not None:
        given["verbose"] = verbose
    if output is not None:
        given["output"] = output
    try:
        return Settings(**given)
    except ValidationError as exc:
        problems = "; ".join(_describe(error) for error in exc.errors())
        msg = f"invalid configuration: {problems}"
        raise SettingsError(msg) from exc


if __name__ == "__main__":
    load_settings()
