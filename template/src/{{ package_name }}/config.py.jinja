"""The tool's identity and its resolved configuration.

Every setting resolves in one order: command-line flag, then environment variable, then the YAML
config file (`config_file.py`), then the field default. pydantic-settings does the merge;
`load_settings` passes only the flags actually given. Every caller passes the global flags whole,
as one `GlobalOptions`, so a global option added there reaches every command with no edit to any
of them. Why it is built this way: .claude/skills/python-cli-modern/reference/configuration.md.

Each field reads `{{ script_name | upper | replace('-', '_') }}_<FIELD>`, so `output` is
`{{ script_name | upper | replace('-', '_') }}_OUTPUT`. To add a setting, follow "Recipe: add a
setting" in the python-cli-modern skill; the wiring tests at the end of `tests/test_config.py` fail,
naming the missed step, until it is done. A credential follows "Recipe: add a secret setting"
instead: typed `SecretStr`, never a flag, and masked everywhere it is shown. Every field is also
read from the config file under its own name, with no further edit.

No `.env` file is read, so a stray file in the working directory cannot change a test's outcome.
To opt in, add `env_file=".env"` to `model_config` and return `dotenv_settings` after
`env_settings` from `settings_customise_sources`.
"""

import dataclasses
import functools
from pathlib import Path
from typing import TypedDict, get_args

from pydantic import Field, SecretStr, ValidationError
from pydantic_core import ErrorDetails
from pydantic_settings import BaseSettings, PydanticBaseSettingsSource, SettingsConfigDict

from .config_file import ConfigFileError, ConfigFileSource, default_config_path
from .output import OutputFormat

PROG_NAME = "{{ script_name }}"
DIST_NAME = "{{ package_name | replace('_', '-') }}"
ENV_PREFIX = "{{ script_name | upper | replace('-', '_') }}_"


class SettingsError(ValueError):
    """A setting failed validation, or the config file could not be read. The message says where."""


class _Overrides(TypedDict, total=False):
    """The flags actually given. A key is present only when its flag was."""

    verbose: bool
    config: Path
    output: OutputFormat


class Settings(BaseSettings):
    """Every setting this tool reads, validated once at the boundary."""

    model_config = SettingsConfigDict(env_prefix=ENV_PREFIX, frozen=True, extra="forbid")

    verbose: bool = False
    config: Path = Field(default_factory=functools.partial(default_config_path, PROG_NAME))
    output: OutputFormat = OutputFormat.table

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[BaseSettings],
        init_settings: PydanticBaseSettingsSource,
        env_settings: PydanticBaseSettingsSource,
        dotenv_settings: PydanticBaseSettingsSource,
        file_secret_settings: PydanticBaseSettingsSource,
    ) -> tuple[PydanticBaseSettingsSource, ...]:
        """Read flags, then the environment, then the config file; skip `.env` and secrets dirs."""
        del dotenv_settings, file_secret_settings
        config_file = ConfigFileSource(settings_cls, default=default_config_path(PROG_NAME))
        return init_settings, env_settings, config_file


def secret_fields() -> list[str]:
    """Return the settings typed `SecretStr`, which take no flag and are masked wherever shown."""
    names: list[str] = []
    for name, info in Settings.model_fields.items():
        if info.annotation is SecretStr or SecretStr in get_args(info.annotation):
            names.append(name)
    return names


def env_var(field: str) -> str:
    """Return the environment variable that sets `field`, e.g. `output` -> `<PREFIX>_OUTPUT`."""
    return f"{ENV_PREFIX}{field.upper()}"


def _describe(error: ErrorDetails) -> str:
    """Render one validation error as `field=value (--flag, VAR or the config file): reason`.

    A secret's value is masked, and it is offered no flag, since it has none.
    """
    field = str(error["loc"][0]) if error["loc"] else "settings"
    if field in secret_fields():
        return f"{field}='**********' ({env_var(field)} or the config file): {error['msg']}"
    flag = f"--{field.replace('_', '-')}"
    sources = f"{flag}, {env_var(field)} or the config file"
    return f"{field}={error['input']!r} ({sources}): {error['msg']}"


@dataclasses.dataclass(frozen=True)
class GlobalOptions:
    """The global flags as given on the command line; `None` means not given.

    The app callback builds it and stores it on the context; each command passes it, whole, to
    `load_settings`. A global option is a field here, never a `load_settings` keyword.
    """

    verbose: bool | None = None
    config: Path | None = None


def load_settings(
    options: GlobalOptions,
    *,
    output: OutputFormat | None = None,
) -> Settings:
    """Resolve settings from the given flags, then the environment, the config file and the defaults.

    `options` is required, so a command cannot drop the global flags by omission: pass
    `global_options(ctx)`, or `GlobalOptions()` where there is no command line. A keyword or field
    left as `None` was not given and does not override anything.
    """
    given: _Overrides = {}
    verbose = options.verbose
    if verbose is not None:
        given["verbose"] = verbose
    config = options.config
    if config is not None:
        given["config"] = config
    if output is not None:
        given["output"] = output
    try:
        return Settings(**given)
    except ValidationError as exc:
        problems = "; ".join(_describe(error) for error in exc.errors())
        msg = f"invalid configuration: {problems}"
        raise SettingsError(msg) from exc
    except ConfigFileError as exc:
        msg = f"invalid configuration: {exc}"
        raise SettingsError(msg) from exc


if __name__ == "__main__":
    load_settings(GlobalOptions())
