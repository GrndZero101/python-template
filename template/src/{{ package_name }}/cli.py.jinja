"""Single entry point: the app, its global options, and every subcommand.

    {{ script_name }} about
    {{ script_name }} -v about --output json
    {{ script_name | upper | replace('-', '_') }}_OUTPUT=json {{ script_name }} about

`about` is a placeholder. Add a command by writing it in its own module as a plain function and
registering it here by reference, beside `about` — "Recipe: add a command" in the
python-cli-modern skill. Shell completion is emitted rather than installed:

    {{ completion_env_var }}=source_zsh {{ script_name }} > "${ZDOTDIR:-$HOME}/completions/_{{ script_name }}"

Why `add_completion=False`: .claude/skills/python-cli-modern/reference/completion.md.
Why the script is never `cli`: .claude/skills/python-cli-modern/reference/typer.md.
"""

import sys

import typer

from .about import about_command
from .config import PROG_NAME, GlobalOptions, SettingsError, load_settings
from .logging_setup import configure_logging
from .options import ConfigOption, VerboseOption, VersionOption
from .typer_entrypoint import run_app

USAGE_ERROR = 2

app = typer.Typer(add_completion=False, no_args_is_help=True)
app.command("about")(about_command)


@app.callback()
def configure(
    ctx: typer.Context,
    *,
    verbose: VerboseOption = None,
    config: ConfigOption = None,
    # Acted on by its eager callback before this body runs, so it is never read here.
    version: VersionOption = False,  # ruff: ignore[unused-function-argument]
) -> None:
    """Global options go before the command name."""
    options = GlobalOptions(verbose=verbose, config=config)
    settings = load_settings(options)
    configure_logging(verbose=settings.verbose)
    ctx.obj = options


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns an exit code; never calls sys.exit itself."""
    try:
        return run_app(app, argv, prog_name=PROG_NAME)
    except SettingsError as exc:
        sys.stderr.write(f"Error: {exc}\n")
        return USAGE_ERROR


if __name__ == "__main__":
    sys.exit(main())
